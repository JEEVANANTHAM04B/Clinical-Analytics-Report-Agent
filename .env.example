# =============================================================================
# Clinical Analytics MVP — Environment Variables Example
# =============================================================================
# INSTRUCTIONS:
#   1. Copy this file and rename it to .env
#   2. Fill in your actual values in .env
#   3. NEVER commit .env to Git — it contains real secrets
#   4. This .env.example file IS safe to commit (no real secrets here)
#   This prototype has no application access control. Use it only on a trusted
#   local development machine; it is not suitable for public deployment.
# =============================================================================

# --- Application Settings ---
APP_NAME="Clinical Analytics MVP"
APP_VERSION="0.1.0"
ENVIRONMENT="development"        # Options: development | staging | production

# --- API Server Settings ---
API_HOST="127.0.0.1"
API_PORT=8001

# --- MySQL Database Settings ---
MYSQL_HOST="localhost"
MYSQL_PORT=3306
MYSQL_DATABASE="clinical_analytics_db"
MYSQL_USER="your_mysql_username"
MYSQL_PASSWORD="your_mysql_password"

# --- Logging Settings ---
LOG_LEVEL="INFO"                 # Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT="json"                # Options: json | text

# --- Phase 2: File Upload Settings ---
MAX_UPLOAD_SIZE_MB=50            # Maximum file upload size in megabytes
UPLOAD_DIRECTORY="data/uploads"  # Local directory where uploaded datasets are stored

# Optional Redis; unset to bypass cache. Use a private, authenticated Redis instance.
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=900
WORKFLOW_MAX_RETRIES=2
RESULT_MAX_RETRIES=2
