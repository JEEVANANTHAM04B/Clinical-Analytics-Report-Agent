# =============================================================================
# Clinical Analytics MVP — .gitignore
# =============================================================================

# --- Environment & Secrets ---
# Environment & Secrets
/.env
*.env.local
*.env.production
*.env.local
*.env.production

# --- Python Virtual Environment ---
venv/
.venv/
env/
ENV/

# --- Python Cache & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# --- Python Distribution & Packaging ---
build/
dist/
*.egg-info/
*.egg
.eggs/

# --- Testing ---
.pytest_cache/
.coverage
htmlcov/
*.coveragerc

# --- IDE & Editor Settings ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- OS Files ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs ---
logs/
*.log
*.log.*

# --- Data & Uploads ---
# Ignore all uploaded files (may contain patient data)
data/uploads/*
# But keep .gitkeep so the directory exists in Git
!data/uploads/.gitkeep
# data/sample/ is NOT ignored — synthetic test data is safe to commit


# --- Vector Database (will be added later) ---
vector_db/
chroma_db/

# --- Jupyter Notebooks (optional, add if needed) ---
.ipynb_checkpoints/

# --- Temporary Files ---
*.tmp
*.bak
*.orig


# --- Frontend ---
frontend/node_modules/
frontend/dist/
frontend/.vite/

# --- Generated Reports / Test Outputs ---
*.pdf
*.html

# --- Temporary / Development Files ---
scratch/
temperary image/

# --- Generated Python Test Files ---
test_*.pdf
test_*.html
.deepeval/
# --- Clinical Trial Raw Archive & RAG Backup ---
Dataset.zip
app/rag/vector_store/langchain_store_bak/
